---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="header-pill">
    <a href={`${base}/`} class="brand" aria-label="shelfmark home">
      <Logo size={24} class="brand-mark" />
      <span class="brand-name">shelfmark</span>
      <span class="brand-by">Dankaro</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href={`${base}/docs/`} class:list={['nav-link', { active: path === `${base}/docs` }]}>Docs</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 1.1rem;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .header-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 2rem;
    width: 100%;
    max-width: 500px;
    padding: 0.75rem 1.25rem;
    background: rgba(247, 245, 241, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-pill);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-right: auto;
  }
  .brand-mark { align-self: center; color: var(--ink); }
  .brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
  }
  .brand-by {
    color: var(--ink-45);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .nav-link {
    color: var(--ink-70);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.active { color: var(--orange); }

  @media (max-width: 540px) {
    .header-pill { padding: 0.7rem 1rem; }
    .brand-by { display: none; }
  }
</style>
