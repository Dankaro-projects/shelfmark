---
// The Dankaro mark: a square outline with an open top-right corner, plugged by
// a floating filled square — "the catalogued item on the shelf".
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M18 4.5H10A5.5 5.5 0 0 0 4.5 10v12A5.5 5.5 0 0 0 10 27.5h12a5.5 5.5 0 0 0 5.5-5.5v-8"
    stroke="currentColor"
    stroke-width="3.6"
    stroke-linecap="round"
  ></path>
  <rect x="21.5" y="3" width="8" height="8" rx="1.6" fill="var(--accent, #4457e6)"></rect>
</svg>
