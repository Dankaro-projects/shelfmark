---
// Sub-page hero: eyebrow + masked headline lines + lede, vertically centred.
// `title` is an array of lines; a line may carry HTML (the one serif-italic word).
// Optional right-side visual: pass `image`/`imageAlt`, or a <video slot="visual">.
interface Props {
  eyebrow: string;
  title: string[];
  lede?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}
const { eyebrow, title, lede, image, imageAlt = '', imageWidth, imageHeight } = Astro.props;
const hasVisual = !!image || Astro.slots.has('visual');
---

<section class="panel panel--hero page-hero">
  <div class="container">
    <div class:list={['hero-wrap', { 'has-visual': hasVisual }]}>
      <div class="hero-text">
        <p class="eyebrow" data-hero-fade>{eyebrow}</p>
        <h1 class="page-title">
          {title.map((line) => (
            <span class="hero-line"><span set:html={line} /></span>
          ))}
        </h1>
        {lede && <p class="section-lede page-lede" data-hero-fade set:html={lede} />}
        <slot />
      </div>
      {hasVisual && (
        <div class="hero-visual" data-hero-fade>
          {image ? (
            <img
              src={image}
              alt={imageAlt}
              width={imageWidth}
              height={imageHeight}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <slot name="visual" />
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero { padding-top: 7rem; }
  .hero-wrap.has-visual {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }
  .page-title {
    margin-top: 1.3rem;
    font-size: clamp(2.5rem, 6.4vw, 4.6rem);
    max-width: 18ch;
  }
  .has-visual .page-title { font-size: clamp(2.3rem, 4.6vw, 3.6rem); }
  .hero-line { display: block; overflow: hidden; padding-block: 0.06em; }
  .hero-line > span { display: block; will-change: transform; }
  .page-lede { font-size: clamp(1.1rem, 1.9vw, 1.4rem); margin-top: 1.5rem; }

  /* The visual is a "plate": the illustration's own cream field, framed. */
  .hero-visual :global(img),
  .hero-visual :global(video) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    background: var(--canvas-light);
  }

  @media (max-width: 900px) {
    .hero-wrap.has-visual { grid-template-columns: 1fr; gap: 2.2rem; }
  }
</style>
