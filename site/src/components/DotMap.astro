---
// The governed map — the site's signature visual. A dot per document; the few
// an agent is permitted to see light orange. Generated at build time with a
// fixed seed so every build renders the same map.
interface Props {
  cols?: number;
  rows?: number;
  lit?: number;
  class?: string;
}
const { cols = 16, rows = 10, lit = 12, class: className = '' } = Astro.props;

// mulberry32 — deterministic PRNG, fixed seed.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(7);

const W = 520;
const H = 340;
const cellW = W / cols;
const cellH = H / rows;

type Dot = { x: number; y: number; r: number };
const dots: Dot[] = [];
for (let c = 0; c < cols; c++) {
  for (let r = 0; r < rows; r++) {
    if (rand() < 0.14) continue; // gaps make it read as an estate, not a grid
    dots.push({
      x: +(c * cellW + cellW / 2 + (rand() - 0.5) * cellW * 0.55).toFixed(1),
      y: +(r * cellH + cellH / 2 + (rand() - 0.5) * cellH * 0.55).toFixed(1),
      r: +(2 + rand() * 1.3).toFixed(1),
    });
  }
}
// Pick the permitted subset, spread across the field.
const litIdx = new Set<number>();
while (litIdx.size < Math.min(lit, dots.length)) {
  litIdx.add(Math.floor(rand() * dots.length));
}
---

<div class={`dotmap ${className}`} data-dotmap>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="A map of many documents; only a permitted few are highlighted.">
    {dots.map((d, i) => (
      <circle
        class:list={['dm-dot', { lit: litIdx.has(i) }]}
        cx={d.x}
        cy={d.y}
        r={litIdx.has(i) ? d.r + 0.8 : d.r}
      />
    ))}
    <line class="dm-scan" x1="0" y1="6" x2="0" y2={H - 6} />
  </svg>
</div>

<style>
  .dotmap {
    background: var(--white);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    box-shadow: var(--shadow-card);
  }
  .dotmap svg { width: 100%; height: auto; }
  .dm-dot { fill: var(--ink); opacity: 0.2; }
  .dm-dot.lit {
    fill: var(--orange);
    opacity: 1;
    filter: drop-shadow(0 0 4px var(--orange-glow));
  }
  .dm-scan {
    stroke: var(--orange);
    stroke-width: 1.5;
    opacity: 0;
  }
</style>
