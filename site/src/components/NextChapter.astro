---
// The narrative chain between pages — each chapter hands off to the next,
// mirroring the slide deck's 2→6 sequence.
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  kicker?: string;
}
const { href, label, kicker = 'Next chapter' } = Astro.props;
---

<section class="panel panel--short next-chapter">
  <div class="container">
    <a href={href} class="next-link" data-reveal>
      <span class="next-kicker">{kicker}</span>
      <span class="next-label">
        {label}
        <Icon name="arrow" class="next-arrow" />
      </span>
    </a>
  </div>
</section>

<style>
  .next-chapter { border-top: 1px solid var(--hairline); }
  .next-link { display: block; }
  .next-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--orange);
  }
  .next-label {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.8rem;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    transition: color 0.3s var(--ease-brand);
  }
  .next-label :global(.next-arrow) {
    width: 0.85em;
    height: 0.85em;
    flex: none;
    transition: transform 0.4s var(--ease-brand);
  }
  .next-link:hover .next-label { color: var(--orange); }
  .next-link:hover .next-label :global(.next-arrow) { transform: translateX(0.35em); }
</style>
