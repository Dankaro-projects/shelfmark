---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextChapter from '../components/NextChapter.astro';
import Icon from '../components/Icon.astro';

// The four stages, each with its own mini dot-field: the same estate,
// progressively governed. Dot states: 'ink' (exists), 'lit' (permitted),
// 'faint' (exists but outside the agent's view).
type DotState = 'ink' | 'lit' | 'faint';
const litSet = new Set([2, 7, 11, 16]);
function stageDots(stage: number): DotState[] {
  return Array.from({ length: 20 }, (_, i) => {
    if (stage <= 1) return 'ink';
    if (stage === 2) return litSet.has(i) ? 'lit' : 'ink';
    return litSet.has(i) ? 'lit' : 'faint';
  });
}

const stages = [
  {
    title: 'Filesystem',
    desc: "Files live in place across your existing systems. We don't move anything.",
    stage: 0,
  },
  {
    title: 'Local catalogue',
    desc: 'Shelfmark indexes file metadata and structure only — not content.',
    stage: 1,
  },
  {
    title: 'Permissions',
    desc: 'Your permissions define what each agent is allowed to see.',
    stage: 2,
  },
  {
    title: 'Agent view',
    desc: "Agents see only what they're allowed to see — nothing more.",
    stage: 3,
  },
];

const guarantees = [
  { icon: 'user', text: 'You decide what an agent can see' },
  { icon: 'shield', text: 'No document content stored' },
  { icon: 'swap', text: 'No forced migration' },
  { icon: 'folder', text: 'No filesystem restructuring' },
  { icon: 'database', text: 'No ingestion of thousands of files into model context' },
  { icon: 'eye-off', text: 'No broad “AI has access to everything” compromise' },
];
---

<Base
  title="The model — shelfmark"
  description="Shelfmark creates a governed map of what exists. Agents understand the estate without full access to the underlying data."
>
  <PageHero
    eyebrow="The model"
    title={[
      'A governed <span class="serif-italic">map</span>',
      'of what exists.',
    ]}
    lede="Agents understand the estate without full access to the underlying data."
  >
    <video
      slot="visual"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/media/model-layers.webp"
      width="1440"
      height="1080"
      aria-label="Exploded architecture diagram in motion: a dense filesystem slab at the bottom, a catalogue grid above it, a perforated permission plate, and a sparse top plane where only a few permitted nodes glow orange."
    >
      <source src="/media/model-layers.mp4" type="video/mp4" />
    </video>
  </PageHero>

  <section class="panel">
    <div class="container">
      <div class="stages" data-reveal="group">
        {stages.map((s, i) => (
          <>
            <div class="card stage-card">
              <svg class="stage-dots" viewBox="0 0 100 80" aria-hidden="true">
                {stageDots(s.stage).map((state, di) => {
                  const x = 12 + (di % 5) * 19;
                  const y = 12 + Math.floor(di / 5) * 19;
                  return <circle class={`sd sd--${state}`} cx={x} cy={y} r={state === 'lit' ? 4 : 3.2} />;
                })}
              </svg>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
            {i < stages.length - 1 && <Icon name="arrow" class="stage-arrow" />}
          </>
        ))}
      </div>

      <div class="banner" data-reveal>
        <div class="banner-icon"><Icon name="layers" /></div>
        <p>
          Shelfmark indexes file metadata and structure only,
          <em> not document bodies.</em>
        </p>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="container">
      <p class="eyebrow" data-reveal>The guarantees</p>
      <h2 class="section-title" data-reveal>Decided in the engine, not left to the caller.</h2>
      <div class="grid-3 guarantee-grid" data-reveal="group">
        {guarantees.map((g) => (
          <div class="card guarantee-card">
            <div class="card-icon"><Icon name={g.icon} /></div>
            <p class="guarantee-text">{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="panel panel--short">
    <div class="container">
      <h2 class="closing-line" data-reveal>
        A lightweight, local,
        <span class="text-orange">permission-aware</span> map of reality.
      </h2>
    </div>
  </section>

  <NextChapter href="/coverage" label="Works where your data lives" />
</Base>

<style>
  .stages {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.9rem;
    align-items: stretch;
  }
  .stage-card { padding: 1.6rem; display: flex; flex-direction: column; }
  .stage-card h3 { font-size: 1.1rem; }
  .stage-card p { font-size: 0.88rem; margin-top: 0.4rem; }
  .stage-dots {
    width: 100%;
    max-width: 130px;
    margin-bottom: 1.2rem;
    background: var(--canvas-light);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xs);
    padding: 0.4rem;
  }
  .sd--ink { fill: var(--ink); opacity: 0.55; }
  .sd--faint { fill: var(--ink); opacity: 0.1; }
  .sd--lit { fill: var(--orange); }
  .stages :global(.stage-arrow) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--orange);
    align-self: center;
    flex: none;
  }
  .banner { margin-top: 2.5rem; }

  .guarantee-grid { margin-top: 3rem; }
  .guarantee-card { display: flex; align-items: center; gap: 1.1rem; padding: 1.5rem; }
  .guarantee-card .card-icon { margin-bottom: 0; flex: none; }
  .guarantee-text { font-weight: 700; font-size: 0.98rem; color: var(--ink); }

  .closing-line { font-size: clamp(1.8rem, 4vw, 3rem); max-width: 26ch; }

  @media (max-width: 900px) {
    .stages { grid-template-columns: 1fr; }
    .stages :global(.stage-arrow) { transform: rotate(90deg); margin-inline: auto; }
    .stage-dots { max-width: 110px; }
  }
</style>
