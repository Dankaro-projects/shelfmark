    .docs-nav-link.active { border-color: var(--orange); }
    .axis-cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Scrollspy: light up the side-nav link for the section in view.
  function spy() {
    const links = document.querySelectorAll('.docs-nav-link');
    const sections = document.querySelectorAll('.doc-section');
    if (!links.length || !sections.length) return;

    const byId = new Map();
    links.forEach((l) => byId.set(l.getAttribute('data-spy'), l));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => l.classList.remove('active'));
          byId.get(e.target.id)?.classList.add('active');
        });
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );
    sections.forEach((s) => io.observe(s));
  }
  document.addEventListener('astro:page-load', spy);
</script>
