---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextChapter from '../components/NextChapter.astro';
import Icon from '../components/Icon.astro';

const steps = [
  {
    cmd: 'shelfmark init',
    desc: 'Write a starter config.toml — and when the default root misses, init sweeps for the folders that do hold documents. One keypress fixes the config.',
  },
  {
    cmd: 'shelfmark refresh',
    desc: 'Build + rights + prune + assertions, incrementally — a couple of seconds over a ~30k-file tree.',
  },
  {
    cmd: 'claude mcp add shelfmark -s user -- shelfmark-mcp',
    desc: 'Connect it. Any client that speaks local MCP can point at the shelfmark-mcp command.',
  },
  {
    cmd: 'shelfmark review --apply',
    desc: 'Optional, worth five minutes: a few questions about your own folders, and rights stop being UNKNOWN.',
  },
];

const tools = [
  {
    name: 'corpus_stats()',
    desc: 'The census: counts, sizes, roots — and it volunteers its own freshness.',
  },
  {
    name: 'browse_folder()',
    desc: 'Answers “what do I have here” without handing back a query builder.',
  },
  {
    name: 'search_docs()',
    desc: 'Full-text search over the catalogue, built to survive hyphenated identifiers.',
  },
  {
    name: 'search_emails()',
    desc: 'The same governed discovery over ingested mail archives.',
  },
  {
    name: 'get_file()',
    desc: 'One document’s record, fetched when the agent decides it is worth opening.',
  },
];

const mcpConfig = `{
  "mcpServers": {
    "shelfmark": {
      "command": "shelfmark-mcp"
    }
  }
}`;
---

<Base
  title="Get started — shelfmark"
  description="pip install shelfmark. One config file, one command to stay current, five MCP tools. Python 3.11+, MIT licensed, local-first."
>
  <PageHero
    eyebrow="Get started"
    title={[
      'One config file.',
      'One command to stay <span class="serif-italic">current</span>.',
    ]}
    lede="Published on PyPI. Python 3.11+. MIT licensed. No index server, no embedding model, no tuning pass — and nothing leaves the machine."
  />

  <section class="panel">
    <div class="container">
      <p class="eyebrow" data-reveal>Install</p>
      <h2 class="section-title" data-reveal>Four commands to a governed estate.</h2>

      <div class="install-chips" data-reveal="group">
        <div class="chip">
          <span>uv tool install shelfmark</span>
          <button class="chip-copy" data-copy="uv tool install shelfmark">Copy</button>
        </div>
        <div class="chip">
          <span>pipx install shelfmark</span>
          <button class="chip-copy" data-copy="pipx install shelfmark">Copy</button>
        </div>
      </div>

      <ol class="steps" data-reveal="group">
        {steps.map((s, i) => (
          <li class="card step-card">
            <span class="step-no mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <code class="step-cmd mono">{s.cmd}</code>
              <p>{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="panel">
    <div class="container">
      <div class="wire-split">
        <div>
          <p class="eyebrow" data-reveal>Wire it in</p>
          <h2 class="section-title" data-reveal>Any MCP-capable agent.</h2>
          <p class="section-lede" data-reveal>
            One command with Claude Code —
            <code class="mono wire-cmd">claude mcp add shelfmark -s user -- shelfmark-mcp</code>
            — or add <code class="mono wire-cmd">shelfmark-mcp</code> to any
            client that speaks the protocol.
          </p>
          <div class="banner banner--rule wire-note" data-reveal>
            <p>
              No tool answers from a snapshot it cannot vouch for.
              <small>
                The server keeps its own index current. Staleness it can heal is
                healed; staleness it cannot is announced — never left silent.
              </small>
            </p>
          </div>
        </div>
        <div class="readout wire-readout" data-reveal>
          <div class="r-dim">// claude_desktop_config.json</div>
          <pre>{mcpConfig}</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="container">
      <p class="eyebrow" data-reveal>The surface</p>
      <h2 class="section-title" data-reveal>Five tools. Nothing to tune.</h2>
      <p class="section-lede" data-reveal>
        No chunk sizes, no embedding model to pick, no query language to learn.
        The sophistication lives in the engine; the surface stays small.
      </p>

      <div class="tools-grid" data-reveal="group">
        {tools.map((t) => (
          <div class="card tool-card">
            <code class="tool-name mono">{t.name}</code>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="panel panel--short">
    <div class="container">
      <h2 class="closing-line" data-reveal>
        See the estate. Respect the boundaries.<br />
        Open only <span class="text-orange">what matters</span>.
      </h2>
      <div class="cta-row" data-reveal>
        <a href="https://pypi.org/project/shelfmark/" rel="noopener" class="btn btn-primary">
          pypi.org/project/shelfmark ↗
        </a>
        <a href="/proof" class="btn btn-secondary">Back to the numbers</a>
      </div>
    </div>
  </section>

  <NextChapter href="/docs" label="The full instructions" kicker="Go deeper" />
</Base>

<style>
  .install-chips {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.4rem;
  }

  .steps {
    list-style: none;
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .step-card { display: flex; gap: 1.2rem; align-items: flex-start; padding: 1.6rem; }
  .step-no { color: var(--orange); font-weight: 700; font-size: 0.8rem; padding-top: 0.25rem; }
  .step-cmd { font-size: 1rem; font-weight: 700; }
  .step-card p { font-size: 0.9rem; color: var(--ink-70); margin-top: 0.4rem; }

  .wire-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }
  .wire-note { margin-top: 2.2rem; }
  .wire-cmd {
    font-size: 0.78em;
    background: var(--ink-06);
    padding: 0.12em 0.45em;
    border-radius: 5px;
  }
  .wire-readout pre {
    font-family: inherit;
    margin-top: 0.5rem;
    white-space: pre;
  }

  .tools-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .tool-card { padding: 1.7rem; }
  .tool-name {
    display: inline-block;
    color: var(--orange);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }
  .tool-card p { font-size: 0.92rem; }

  .closing-line { font-size: clamp(1.8rem, 4vw, 3rem); max-width: 26ch; }
  .cta-row { display: flex; gap: 0.9rem; margin-top: 2.4rem; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
    .wire-split { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
