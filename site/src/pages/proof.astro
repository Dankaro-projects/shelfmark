---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextChapter from '../components/NextChapter.astro';
import Icon from '../components/Icon.astro';

// Donut geometry: r=44 → circumference ≈ 276.5. The arc shows the corpus
// indexed-in-place (full sweep, minus a small remainder for legibility).
const C = 276.5;
const donutTo = +(C * 0.12).toFixed(1); // sweep ~88% of the ring

// Token matrix: 48 cells, the handful an agent actually spends lit orange.
const tokenCells = Array.from({ length: 48 }, (_, i) => i < 5);
---

<Base
  title="Proof points — shelfmark"
  description="40,000 files / 65 GB indexed in under 2 seconds. A 74 GB OneDrive corpus validated on Windows ARM64. 500–1,000 tokens of discovery context."
>
  <PageHero
    eyebrow="Proof points"
    title={[
      'Fast to <span class="serif-italic">index</span>.',
      'Cheap to query.',
    ]}
    lede="Measured on real document estates — not benchmarks built to flatter."
  />

  <section class="panel">
    <div class="container">
      <div class="grid-3 proof-grid" data-reveal="group">
        <!-- ---- 1 · speed ---- -->
        <div class="card proof-card">
          <div class="card-icon"><Icon name="timer" /></div>
          <span class="proof-num"><span class="mono" data-count-to="40000">0</span></span>
          <span class="proof-unit">files / 65 GB</span>
          <p class="proof-claim">Indexed in under 2 seconds</p>
          <p class="proof-desc">Structured, queryable map produced almost instantly.</p>
          <div class="meter" role="img" aria-label="Indexing completes just under the 2 second mark.">
            <div class="meter-scale mono"><span>0s</span><span>1s</span><span>2s</span></div>
            <div class="meter-track">
              <div class="meter-fill" data-grow="92"></div>
              <div class="meter-dot"></div>
            </div>
          </div>
        </div>

        <!-- ---- 2 · cloud-backed ---- -->
        <div class="card proof-card">
          <div class="card-icon"><Icon name="cloud" /></div>
          <span class="proof-num"><span class="mono" data-count-to="74">0</span> GB</span>
          <span class="proof-unit">OneDrive corpus</span>
          <p class="proof-claim">Validated on Windows ARM64</p>
          <p class="proof-desc">Indexed without downloads or local eviction of files.</p>
          <div class="donut-wrap">
            <svg viewBox="0 0 110 110" class="donut" role="img" aria-label="74 GB indexed in place.">
              <circle class="donut-track" cx="55" cy="55" r="44" />
              <circle
                class="donut-arc"
                cx="55" cy="55" r="44"
                stroke-dasharray={C}
                stroke-dashoffset={C}
                data-draw={C}
                data-draw-to={donutTo}
              />
            </svg>
            <div class="donut-label">
              <strong>74 GB</strong>
              <span>indexed</span>
            </div>
          </div>
        </div>

        <!-- ---- 3 · tokens ---- -->
        <div class="card proof-card">
          <div class="card-icon"><Icon name="frame" /></div>
          <span class="proof-num"><span class="mono">500–1,000</span></span>
          <span class="proof-unit">tokens</span>
          <p class="proof-claim">Typical discovery context footprint</p>
          <p class="proof-desc">Agents use minimal structure to decide what to open next.</p>
          <div class="token-dots" role="img" aria-label="A small fraction of the context window is enough for discovery.">
            {tokenCells.map((lit) => (
              <span class:list={['td', { lit }]}></span>
            ))}
          </div>
        </div>
      </div>

      <div class="banner" data-reveal>
        <div class="banner-icon"><Icon name="star" /></div>
        <p>
          Shelfmark <em>does not require data to move</em> in order to be understood.
        </p>
      </div>
    </div>
  </section>

  <NextChapter href="/get-started" label="Get started" kicker="Put it to work" />
</Base>

<style>
  .proof-grid { align-items: stretch; }
  .proof-card { display: flex; flex-direction: column; }
  .proof-num {
    font-size: clamp(2.4rem, 3.6vw, 3.2rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
  }
  .proof-unit { font-weight: 700; color: var(--ink-70); margin-top: 0.15rem; }
  .proof-claim {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
    color: var(--orange);
    font-weight: 800;
    font-size: 0.95rem;
  }
  .proof-desc { font-size: 0.9rem; color: var(--ink-70); margin-top: 0.35rem; }

  /* meter */
  .meter { margin-top: auto; padding-top: 1.8rem; }
  .meter-scale {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--ink-45);
    margin-bottom: 0.45rem;
  }
  .meter-track {
    position: relative;
    height: 4px;
    background: var(--ink-06);
    border-radius: var(--radius-full);
  }
  .meter-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: var(--orange);
    border-radius: var(--radius-full);
  }
  .meter-dot {
    position: absolute;
    top: 50%;
    right: 8%;
    width: 12px;
    height: 12px;
    transform: translate(50%, -50%);
    background: var(--orange);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--orange-glow);
  }

  /* donut */
  .donut-wrap {
    margin-top: auto;
    padding-top: 1.6rem;
    position: relative;
    width: 130px;
    align-self: center;
  }
  .donut { width: 100%; transform: rotate(-90deg); }
  .donut-track {
    fill: none;
    stroke: var(--ink-06);
    stroke-width: 11;
  }
  .donut-arc {
    fill: none;
    stroke: var(--orange);
    stroke-width: 11;
    stroke-linecap: round;
  }
  .donut-label {
    position: absolute;
    inset: 1.6rem 0 0 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  .donut-label strong { font-size: 1.05rem; letter-spacing: var(--tracking-snug); }
  .donut-label span { font-size: 0.72rem; color: var(--ink-70); font-weight: 600; }

  /* token matrix */
  .token-dots {
    margin-top: auto;
    padding-top: 1.8rem;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 7px;
    max-width: 240px;
  }
  .td {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-12);
  }
  .td.lit { background: var(--orange); box-shadow: 0 0 6px var(--orange-glow); }

  .banner { margin-top: 2.5rem; }
</style>
