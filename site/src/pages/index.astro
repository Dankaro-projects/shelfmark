---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const storage = [
  { icon: 'drive', label: 'Local drives' },
  { logo: '/media/icloud.svg', label: 'iCloud' },
  { logo: '/media/onedrive.svg', label: 'OneDrive' },
  { logo: '/media/nextcloud.svg', label: 'Nextcloud' },
  { icon: 'network', label: 'Network shares' },
];

const principles = [
  {
    icon: 'drive',
    title: 'Files stay in place',
    text: 'No migration, duplicate corpus, or reorganisation project.',
  },
  {
    icon: 'database',
    title: 'The catalogue stays local',
    text: 'Shelfmark records metadata and structure, never document bodies.',
  },
  {
    icon: 'shield',
    title: 'Permissions stay in control',
    text: 'Every agent receives only the view it is allowed to discover.',
  },
];

const guarantees = [
  'No document content stored',
  'No forced migration',
  'No broad filesystem access',
  'No stale index presented as complete',
];
---

<Base
  title="Shelfmark | Governed document discovery"
  description="Shelfmark gives AI agents a governed map of your document estate while files and content stay in place."
>
  <div class="home-story">
    <section id="intro" class="panel panel--hero home-slide home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow" data-hero-fade>A Dankaro product</p>
          <h1 class="hero-title">
            <span class="hero-line"><span>Know what <span class="serif-italic">exists</span>.</span></span>
            <span class="hero-line"><span>Reveal what matters.</span></span>
          </h1>
          <p class="section-lede" data-hero-fade>
            Shelfmark gives AI agents a governed map of the files already on
            your systems. It reveals structure, enforces boundaries, and leaves
            every document where it is.
          </p>
          <div class="hero-actions" data-hero-fade>
            <a href="/docs#quickstart" class="btn btn-primary">Get started</a>
            <a href="/docs" class="btn btn-secondary">Read the docs</a>
          </div>
          <div class="chip" data-hero-fade>
            <span>uv tool install shelfmark</span>
            <button class="chip-copy" data-copy="uv tool install shelfmark">Copy</button>
          </div>
        </div>

        <div class="hero-film" data-hero-fade>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/model-layers.webp"
            width="1440"
            height="1080"
            aria-label="A filesystem, local catalogue, permission layer, and governed agent view assembling above one another."
          >
            <source src="/media/model-layers.mp4" type="video/mp4" />
          </video>
          <div class="film-caption mono">
            <span>filesystem</span>
            <Icon name="arrow" />
            <span>catalogue</span>
            <Icon name="arrow" />
            <span class="text-orange">governed view</span>
          </div>
        </div>
      </div>
    </section>

    <section id="problem" class="panel home-slide">
      <div class="container story-grid">
        <div class="story-visual" data-reveal>
          <img
            src="/media/problem-estate.webp"
            alt="A complex document estate distributed across computers, storage systems, and nested folders."
            width="1400"
            height="1045"
            loading="lazy"
          />
        </div>
        <div class="story-copy">
          <p class="eyebrow" data-reveal>The reality</p>
          <h2 class="section-title" data-reveal>
            Your knowledge is not missing. It is scattered.
          </h2>
          <p class="section-lede" data-reveal>
            Years of reports, research, presentations, and working files already
            exist. The hard part is discovering what matters without giving an
            agent unrestricted access to everything.
          </p>
          <div class="storage-list" data-reveal="group" aria-label="Supported storage">
            {storage.map((item) => (
              <span class="storage-item">
                {item.logo
                  ? <img src={item.logo} alt="" width="24" height="24" />
                  : item.icon && <Icon name={item.icon} />}
                <span>{item.label}</span>
              </span>
            ))}
          </div>
          <p class="story-rule" data-reveal>
            Useful AI should not require a migration project first.
          </p>
        </div>
      </div>
    </section>

    <section id="product" class="panel home-slide product-slide">
      <div class="container product-grid">
        <div class="product-film" data-reveal>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/estate-scan-poster.jpg"
            width="1920"
            height="1080"
            aria-label="An enterprise file estate becomes a structured map as an orange scan passes over it."
          >
            <source src="/media/estate-scan.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="product-copy">
          <p class="eyebrow" data-reveal>The product</p>
          <h2 class="section-title" data-reveal>Map the estate in place.</h2>
          <p class="section-lede" data-reveal>
            Shelfmark builds a fast local catalogue from the signals your
            filesystem already has. Agents can orient, narrow the search, and
            choose what is worth opening next.
          </p>
          <div class="principle-list" data-reveal="group">
            {principles.map((item) => (
              <div class="principle">
                <div class="card-icon"><Icon name={item.icon} /></div>
                <div>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="governance" class="panel home-slide">
      <div class="container story-grid governance-grid">
        <div class="story-copy">
          <p class="eyebrow" data-reveal>The boundary</p>
          <h2 class="section-title" data-reveal>
            Agents see a view, not the filesystem.
          </h2>
          <p class="section-lede" data-reveal>
            Shelfmark applies privacy and rights rules before results reach the
            caller. The boundary lives in the engine, not in a prompt that can
            be forgotten.
          </p>
          <ul class="guarantee-list" data-reveal="group">
            {guarantees.map((item) => (
              <li><Icon name="check-circle" /> {item}</li>
            ))}
          </ul>
          <a href="/docs#governance" class="text-link" data-reveal>
            Read the governance model <Icon name="arrow" />
          </a>
        </div>
        <div class="story-visual" data-reveal>
          <img
            src="/media/coverage-topology.webp"
            alt="Storage systems remain in place while structural index lines converge on one local catalogue."
            width="1400"
            height="1045"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section id="proof" class="panel home-slide proof-slide">
      <div class="container">
        <div class="proof-heading">
          <div>
            <p class="eyebrow" data-reveal>Built for working collections</p>
            <h2 class="section-title" data-reveal>Fast to index. Light to query.</h2>
          </div>
          <p class="section-lede" data-reveal>
            The catalogue is deliberately small, local, and useful before any
            document content enters a model context.
          </p>
        </div>

        <div class="grid-3 stat-grid" data-reveal="group">
          <div class="card stat-card">
            <span class="stat-num">Thousands</span>
            <span class="stat-unit">of files</span>
            <p>Catalogued in seconds</p>
          </div>
          <div class="card stat-card">
            <span class="stat-num">Large</span>
            <span class="stat-unit">document collections</span>
            <p>Works across local and cloud storage</p>
          </div>
          <div class="card stat-card">
            <span class="stat-num">Small</span>
            <span class="stat-unit">context footprint</span>
            <p>Structure first, content only when needed</p>
          </div>
        </div>

        <div class="closing-cta" data-reveal>
          <div>
            <strong>One config file. One command to stay current.</strong>
            <span>Python 3.11+. MIT licensed. Local by design.</span>
          </div>
          <div class="closing-actions">
            <a href="/docs#quickstart" class="btn btn-primary">Install Shelfmark</a>
            <a href="https://github.com/Dankaro-projects/shelfmark" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-story { position: relative; counter-reset: chapter; }
  .home-slide { counter-increment: chapter; }

  @media (min-width: 901px) and (min-height: 720px) and (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-snap-type: y proximity; }
    .home-slide {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 100svh;
      overflow: hidden;
      scroll-snap-align: start;
      padding-block: clamp(5.5rem, 9vh, 6.5rem) 3rem;
      background: var(--canvas);
      border-top: 1px solid var(--hairline-strong);
      box-shadow: 0 -24px 60px rgba(17, 17, 17, 0.08);
      isolation: isolate;
    }
    .home-slide:nth-child(even) { background: var(--canvas-light); }
    .home-slide:first-child { border-top: 0; box-shadow: none; }
    .home-slide::after {
      content: "0" counter(chapter) " / 05";
      position: absolute;
      right: max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter)));
      bottom: 1.2rem;
      color: var(--ink-45);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
    }
    :global(.site-footer) { scroll-snap-align: start; }
  }

  .hero-grid,
  .story-grid,
  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .hero-title {
    margin-top: 1.2rem;
    font-size: clamp(2.8rem, 5.7vw, 4.8rem);
  }
  .hero-line { display: block; overflow: hidden; padding-block: 0.06em; }
  .hero-line > span { display: block; will-change: transform; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero-copy .chip { margin-top: 1.25rem; }

  .hero-film,
  .story-visual,
  .product-film {
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-lg);
    background: var(--canvas-light);
    box-shadow: var(--shadow-card);
  }
  .hero-film video,
  .story-visual img,
  .product-film video {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-film video { max-height: 66svh; object-fit: cover; }
  .film-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--white);
    color: var(--ink-70);
    font-size: 0.72rem;
  }
  .film-caption :global(svg) { width: 0.9rem; color: var(--ink-45); }

  .story-copy .section-title,
  .product-copy .section-title { max-width: 16ch; }
  .story-visual img { max-height: 64svh; object-fit: cover; }
  .storage-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 2rem;
    overflow-x: auto;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    background: var(--white);
  }
  .storage-item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 0.35rem;
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
  }
  .storage-item + .storage-item { border-left: 1px solid var(--hairline-strong); }
  .storage-item img,
  .storage-item :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }
  .storage-item :global(svg) { color: var(--orange); }
  .story-rule {
    margin-top: 2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--orange);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .product-grid { grid-template-columns: 1.15fr 0.85fr; }
  .product-film video { height: min(66svh, 660px); object-fit: cover; }
  .principle-list { margin-top: 2rem; }
  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: center;
    padding-block: 1rem;
  }
  .principle + .principle { border-top: 1px solid var(--hairline-strong); }
  .principle .card-icon { margin: 0; }
  .principle strong { display: block; font-size: 0.95rem; }
  .principle span { display: block; margin-top: 0.15rem; color: var(--ink-70); font-size: 0.82rem; }

  .governance-grid .story-copy { order: 1; }
  .governance-grid .story-visual { order: 2; }
  .guarantee-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-top: 2rem;
    list-style: none;
  }
  .guarantee-list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .guarantee-list :global(svg) { width: 1.1rem; color: var(--orange); flex: none; }
  .governance-grid .text-link { margin-top: 2rem; }

  .proof-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
  }
  .proof-heading .section-lede { margin-top: 0; }
  .stat-grid { margin-top: 3rem; }
  .stat-card { display: flex; flex-direction: column; }
  .stat-num {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }
  .stat-unit { margin-top: 0.3rem; color: var(--ink-70); font-weight: 700; }
  .stat-card p {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    color: var(--orange);
    font-weight: 700;
  }
  .closing-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
    padding: 1.4rem 1.6rem;
    border-radius: var(--radius-md);
    background: var(--ink);
    color: var(--white);
  }
  .closing-cta strong { display: block; font-size: 1.05rem; }
  .closing-cta span { display: block; margin-top: 0.2rem; color: rgba(255, 255, 255, 0.58); font-size: 0.82rem; }
  .closing-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .closing-cta .btn-primary { background: var(--orange); }
  .closing-cta .btn-primary:hover { background: var(--white); color: var(--ink); }
  .closing-cta .btn-secondary { border-color: rgba(255, 255, 255, 0.5); color: var(--white); }
  .closing-cta .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }

  @media (max-width: 900px) {
    .hero-grid,
    .story-grid,
    .product-grid,
    .proof-heading { grid-template-columns: 1fr; gap: 2.2rem; }
    .home-slide { min-height: auto; padding-block: 4.5rem; }
    .home-hero { min-height: 100svh; padding-top: 7rem; }
    .hero-film { order: -1; margin-top: 1rem; }
    .hero-film video { max-height: 42svh; }
    .story-visual img,
    .product-film video { max-height: 52svh; height: auto; }
    .governance-grid .story-visual { order: 0; }
    .governance-grid .story-copy { order: 1; }
    .closing-cta { align-items: flex-start; flex-direction: column; }
  }

  @media (max-height: 719px) {
    .home-slide { min-height: auto; padding-block: 4.5rem; }
    .home-hero { min-height: 100svh; padding-top: 7rem; }
  }

  @media (max-width: 560px) {
    .storage-list { grid-template-columns: repeat(5, 6.75rem); }
    .guarantee-list { grid-template-columns: 1fr; }
    .film-caption { gap: 0.4rem; font-size: 0.62rem; }
    .closing-actions { width: 100%; }
    .closing-actions .btn { width: 100%; }
  }
</style>
