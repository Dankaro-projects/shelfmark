---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextChapter from '../components/NextChapter.astro';
import Icon from '../components/Icon.astro';

const storage = [
  { icon: 'drive', label: 'Local drives' },
  { icon: 'network', label: 'Network shares' },
  { icon: 'cloud', label: 'iCloud' },
  { icon: 'cloud', label: 'OneDrive' },
  { icon: 'sync', label: 'Nextcloud' },
  { icon: 'database', label: 'External disks' },
  { icon: 'folder', label: 'Legacy sync folders' },
];

const rejected = [
  {
    icon: 'folder',
    title: 'Reorganise everything',
    desc: 'A cleanup project that stalls before it reaches the folders that matter — and starts decaying the day it ships.',
  },
  {
    icon: 'cloud',
    title: 'Migrate into a new platform',
    desc: 'Move years of working files to make them legible to one tool, then maintain two versions of reality forever.',
  },
  {
    icon: 'alert',
    title: 'Grant broad filesystem access',
    desc: 'Give an AI agent everything and hope for the best — privacy as an afterthought, context by accident.',
  },
];
---

<Base
  title="The problem — shelfmark"
  description="Enterprise knowledge already exists. The real problem is access, privacy, and context — not another migration."
>
  <PageHero
    eyebrow="The problem"
    title={[
      'Enterprise knowledge',
      'already <span class="serif-italic">exists</span>.',
    ]}
    lede="The real problem is <strong>access</strong>, <strong>privacy</strong>, and <strong>context</strong>."
    image="/media/problem-estate.webp"
    imageAlt="Isometric technical diagram of a sprawling enterprise file estate — laptops, NAS racks, cloud endpoints and nested folder trees tangled together; a single orange route dead-ends at a missing node."
    imageWidth={1400}
    imageHeight={1045}
  />

  <section class="panel">
    <div class="container">
      <div class="split">
        <div>
          <h2 class="section-title" data-reveal>Scattered, nested, inconsistent.</h2>
          <p class="section-lede" data-reveal>
            Years of reports, presentations, research, proposals, and working
            files already exist. But they are scattered across deeply nested,
            inconsistent, messy storage systems.
          </p>
        </div>
        <ul class="storage-list" data-reveal="group">
          {storage.map((s) => (
            <li>
              <Icon name={s.icon} class="storage-icon" />
              {s.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="container">
      <p class="eyebrow" data-reveal>The default response</p>
      <h2 class="section-title" data-reveal>Three ways to make it worse.</h2>
      <div class="grid-3 rejected-grid" data-reveal="group">
        {rejected.map((r) => (
          <div class="card">
            <div class="rejected-head">
              <div class="card-icon"><Icon name={r.icon} /></div>
              <Icon name="x-circle" class="rejected-x" />
            </div>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>

      <div class="banner banner--rule" data-reveal>
        <div class="banner-icon"><Icon name="target" /></div>
        <p>
          Messy environments are not an edge case.
          <em> They are the reality.</em>
        </p>
      </div>
    </div>
  </section>

  <section class="panel panel--short">
    <div class="container">
      <h2 class="closing-line" data-reveal>
        Agents don't need everything.<br />
        They need to know <span class="text-orange">what they can access</span>.
      </h2>
    </div>
  </section>

  <NextChapter href="/model" label="The model" />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }
  .storage-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    padding: 0.6rem;
  }
  .storage-list li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem;
    font-weight: 700;
    font-size: 0.98rem;
  }
  .storage-list li + li { border-top: 1px solid var(--hairline); }
  .storage-list li :global(.storage-icon) { width: 1.2rem; height: 1.2rem; color: var(--orange); flex: none; }

  .rejected-grid { margin-top: 3rem; }
  .rejected-head { display: flex; justify-content: space-between; align-items: flex-start; }
  .rejected-head :global(.rejected-x) { width: 1.4rem; height: 1.4rem; color: var(--gray); }
  .banner { margin-top: 2.5rem; }

  .closing-line {
    font-size: clamp(1.8rem, 4vw, 3rem);
    max-width: 24ch;
  }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
